@startuml
title R9 - Decorator
interface ConsultaAcervo {
  +metadados(id : String) : Optional<MetadadosLivro>
  +estadoAtual(id : String) : Optional<String>
}
class ConsultaAcervoOriginal
class ConsultaComMedicao
class ConsultaComCache
ConsultaAcervoOriginal ..|> ConsultaAcervo
ConsultaComMedicao ..|> ConsultaAcervo
ConsultaComCache ..|> ConsultaAcervo
ConsultaComMedicao o-- ConsultaAcervo : proxima
ConsultaComCache o-- ConsultaAcervo : proxima
@enduml
