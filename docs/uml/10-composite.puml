@startuml
title R10 - Composite
abstract class ComponenteDoAcervo {
  +nome() : String
  +contarLivros() : int
  +listarLivros() : List<String>
}
class Grupo {
  +adicionar(c : ComponenteDoAcervo)
  +remover(c : ComponenteDoAcervo)
  +moverLivro(id : String, destino : Grupo)
}
class ItemLivro {
  -idLivro : String
}
Grupo --|> ComponenteDoAcervo
ItemLivro --|> ComponenteDoAcervo
Grupo o-- "*" ComponenteDoAcervo : filhos
@enduml
