@startuml
title R7 - Template Method
abstract class CadastroTemplate {
  +incluir(d) : T <<final>>
  #buscarExistente(d)
  #validar(d)
  #verificarPreRequisitos(d)
  #criar(d)
  #armazenar(t)
  #apresentar(t)
  #depoisDeArmazenar(t) <<gancho>>
}
class CadastroLivro
class CadastroPessoa
class CadastroEstudante
class CadastroAtendente
interface iLivro
interface iPessoa
interface iEstudante
interface iAtendente
CadastroLivro --|> CadastroTemplate
CadastroPessoa --|> CadastroTemplate
CadastroEstudante --|> CadastroTemplate
CadastroAtendente --|> CadastroTemplate
Livro ..|> iLivro
Pessoa ..|> iPessoa
Estudante ..|> iEstudante
Atendente ..|> iAtendente
@enduml
