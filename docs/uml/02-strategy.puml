@startuml
title R2 - Strategy
interface PoliticaDeMulta { +nome() : String\n+calcular(diasAtraso : long) : BigDecimal }
class PoliticaOriginal
class PoliticaComTeto
class PoliticaComTolerancia
class ConfiguracaoAdministrativa { +politicaVigente() : PoliticaDeMulta\n+definirPolitica(p) }
class ServicoDeMulta { +emitir(e : EventoDevolucao) : Optional<Multa>\n+receberNotificacao(n : Object) : boolean }
class Multa { -valor : BigDecimal\n-politicaAplicada : String\n-situacao : String }
PoliticaOriginal ..|> PoliticaDeMulta
PoliticaComTeto ..|> PoliticaDeMulta
PoliticaComTolerancia ..|> PoliticaDeMulta
ConfiguracaoAdministrativa o-- PoliticaDeMulta
ServicoDeMulta --> ConfiguracaoAdministrativa
ServicoDeMulta ..> Multa : cria
@enduml
