@startuml
title R2 - Strategy
interface PoliticaDeMulta {
  +nome() : String
  +calcular(diasAtraso : long) : BigDecimal
}
class PoliticaOriginal
class PoliticaComTeto
class PoliticaComTolerancia
class ConfiguracaoAdministrativa {
  +politicaVigente() : PoliticaDeMulta
  +definirPolitica(p : PoliticaDeMulta)
}
class ServicoDeMulta {
  +emitir(e : EventoDevolucao) : Optional<Multa>
  +receberNotificacao(n : Object) : boolean
}
class Multa {
  -valor : BigDecimal
  -politicaAplicada : String
  -situacao : String
}
PoliticaOriginal ..|> PoliticaDeMulta
PoliticaComTeto ..|> PoliticaDeMulta
PoliticaComTolerancia ..|> PoliticaDeMulta
ConfiguracaoAdministrativa o-- PoliticaDeMulta
ServicoDeMulta --> ConfiguracaoAdministrativa
ServicoDeMulta ..> Multa : cria
@enduml
