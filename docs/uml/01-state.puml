@startuml
title R1 - State
class Livro { -id : String\n-titulo : String\n+reservar() : boolean\n+emprestar() : boolean\n+renovar(e : Emprestimo) : boolean\n+devolver() : boolean\n+aprovarInspecao() : boolean\n+enviarParaReparo() : boolean\n+retornarDoReparo() : boolean\n+registrarLaudoIrrecuperavel() : boolean\n+setEstado(e : EstadoLivro) }
interface EstadoLivro { +nome() : String\n+reservar(l : Livro) : boolean\n+emprestar(l : Livro) : boolean\n+renovar(l : Livro, e : Emprestimo) : boolean\n+devolver(l : Livro) : boolean\n+aprovarInspecao(l : Livro) : boolean\n+enviarParaReparo(l : Livro) : boolean\n+retornarDoReparo(l : Livro) : boolean\n+registrarLaudoIrrecuperavel(l : Livro) : boolean }
abstract class EstadoBase
Livro o-- "1" EstadoLivro : estado
EstadoBase ..|> EstadoLivro
EstadoLivre --|> EstadoBase
EstadoReservado --|> EstadoBase
EstadoEmprestado --|> EstadoBase
EstadoRenovado --|> EstadoBase
EstadoDevolvido --|> EstadoBase
EstadoReparando --|> EstadoBase
EstadoIncinerado --|> EstadoBase
@enduml
