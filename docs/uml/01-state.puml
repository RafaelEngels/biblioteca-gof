@startuml
title R1 - State
class Livro {
  -id : String
  -titulo : String
  +reservar() : boolean
  +emprestar() : boolean
  +renovar(e : Emprestimo) : boolean
  +devolver() : boolean
  +aprovarInspecao() : boolean
  +enviarParaReparo() : boolean
  +retornarDoReparo() : boolean
  +registrarLaudoIrrecuperavel() : boolean
  +setEstado(e : EstadoLivro)
}
interface EstadoLivro {
  +nome() : String
  +reservar(l : Livro) : boolean
  +emprestar(l : Livro) : boolean
  +renovar(l : Livro, e : Emprestimo) : boolean
  +devolver(l : Livro) : boolean
  +aprovarInspecao(l : Livro) : boolean
  +enviarParaReparo(l : Livro) : boolean
  +retornarDoReparo(l : Livro) : boolean
  +registrarLaudoIrrecuperavel(l : Livro) : boolean
}
abstract class EstadoBase
Livro o-- "1" EstadoLivro : estado
EstadoBase ..|> EstadoLivro
EstadoLivre --|> EstadoBase
EstadoReservado --|> EstadoBase
EstadoEmprestado --|> EstadoBase
EstadoRenovado --|> EstadoBase
EstadoDevolvido --|> EstadoBase
EstadoReparando --|> EstadoBase
EstadoIncinerado --|> EstadoBase
@enduml
