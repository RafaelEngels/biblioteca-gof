@startuml
title R6 - Command
interface SolicitacaoDeCirculacao {
  +id() : String
  +autor() : String
  +criadaEm() : Instant
  +executar(f : FachadaDeCirculacao) : Comprovante
}
class SolicitacaoDeReserva <<record>>
class SolicitacaoDeRenovacao <<record>>
class ExecutorDeSolicitacoes {
  +executar(s : SolicitacaoDeCirculacao) : Comprovante
}
class FachadaDeCirculacao
class TratadorDeEmprestimo
SolicitacaoDeReserva ..|> SolicitacaoDeCirculacao
SolicitacaoDeRenovacao ..|> SolicitacaoDeCirculacao
TratadorDeEmprestimo ..> SolicitacaoDeCirculacao : cria
TratadorDeEmprestimo --> ExecutorDeSolicitacoes
ExecutorDeSolicitacoes --> FachadaDeCirculacao
@enduml
